# Shohnoma — Apache (Plesk). Statik sahifalar + PHP API + dinamik yo‘llar.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Maxfiy fayllar
<FilesMatch "^\.|\.(env|sql|md|lock|json\.dist)$">
  Require all denied
</FilesMatch>
<Files "templates.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Payme Basic auth sarlavhasi PHP-FPM/CGI ga yetib borishi uchun
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# HTTPS ga yo‘naltirish
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www → asosiy domen
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# API va yuklangan fayllar → PHP
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
RewriteRule ^files/(.*)$ api/index.php [QSA,L]

# Mavjud fayl/papka — o‘zi
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Oxiriga / qo‘shish (trailingSlash)
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Dinamik sahifalar: bitta "_" qobiq sahifa, haqiqiy id brauzerda URL'dan o‘qiladi
RewriteRule ^buyurtma/[^/]+/(.*)$ buyurtma/_/$1 [L]
RewriteRule ^kabinet/t/[^/]+/(.*)$ kabinet/t/_/$1 [L]


# Mehmon taklifnomasi: /jasur-madina/ → invite.php (OG meta bilan)
RewriteRule ^([a-z0-9][a-z0-9-]{1,79})/$ invite.php?slug=$1 [QSA,L]
