# Shohnoma — Apache (Plesk). Statik sahifalar + PHP API + dinamik yo‘llar.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Maxfiy fayllar
<FilesMatch "^\.|\.(env|sql|md|lock|json\.dist)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(templates|cards)\.json$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Favicon/OG nomlari o‘zgarmaydi — yangilanishi ko‘rinishi uchun qisqa kesh
  <FilesMatch "^(favicon\.ico|favicon-(light|dark)-32\.png|icon\.svg|icon-(192|512)\.png|apple-touch-icon\.png|manifest\.webmanifest|opengraph-image.*)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest

# Payme Basic auth sarlavhasi PHP-FPM/CGI ga yetib borishi uchun
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# HTTPS ga yo‘naltirish
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www → asosiy domen
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# API va yuklangan fayllar → PHP
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
RewriteRule ^files/(.*)$ api/index.php [QSA,L]

# Maqolalar — server tomonda yig‘iladi (SEO: to‘liq matn va meta JS’siz ham), php/article.php
RewriteRule ^sitemap-maqolalar\.xml$ article.php?sitemap=1 [L]
RewriteRule ^sitemap-vizitka\.xml$ card.php?sitemap=1 [L]
RewriteRule ^(?:(ru|en)/)?maqolalar/$ article.php?lang=$1 [QSA,L]
RewriteRule ^(?:(ru|en)/)?maqolalar/([^/]+)/$ article.php?lang=$1&slug=$2 [QSA,L]
# Brauzerdagi o‘tishlar (Next RSC) uchun — maqola qobig‘i
RewriteRule ^(ru/|en/)?maqolalar/[a-z0-9-]+/index\.txt$ $1maqolalar/_/index.txt [L]

# Mavjud fayl/papka — o‘zi
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Oxiriga / qo‘shish (trailingSlash)
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Dinamik sahifalar: bitta "_" qobiq sahifa, haqiqiy id brauzerda URL'dan o‘qiladi
RewriteRule ^buyurtma/[^/]+/(.*)$ buyurtma/_/$1 [L]
RewriteRule ^kabinet/t/[^/]+/(.*)$ kabinet/t/_/$1 [L]
# Raqamli vizitka: /v/<slug>/ → card.php (OG meta; to‘lanmagan → 404). Brauzer o‘tishlari (RSC) uchun — qobiq
RewriteRule ^v/[a-z0-9][a-z0-9-]{1,79}/index\.txt$ v/_/index.txt [L]
RewriteRule ^v/([a-z0-9][a-z0-9-]{1,79})/$ card.php?slug=$1 [QSA,L]
# Vizitka buyurtma oqimi va kabinet qobiqlari (uz/ru/en)
RewriteRule ^(ru/|en/)?vizitka/buyurtma/[^/]+/(.*)$ $1vizitka/buyurtma/_/$2 [L]
RewriteRule ^(ru/|en/)?kabinet/v/[^/]+/(.*)$ $1kabinet/v/_/$2 [L]
# Admin qo‘shgan shablonlar (statik sahifasi yo‘q) → qobiq
RewriteRule ^shablonlar/[a-z0-9-]+/$ shablonlar/_/index.html [L]
RewriteRule ^shablonlar/[a-z0-9-]+/index\.txt$ shablonlar/_/index.txt [L]
RewriteRule ^namuna/[a-z0-9-]+/$ namuna/_/index.html [L]
RewriteRule ^namuna/[a-z0-9-]+/index\.txt$ namuna/_/index.txt [L]
# Ruscha versiya (/ru/...) — xuddi shu qobiqlar
RewriteRule ^ru/buyurtma/[^/]+/(.*)$ ru/buyurtma/_/$1 [L]
RewriteRule ^ru/kabinet/t/[^/]+/(.*)$ ru/kabinet/t/_/$1 [L]
RewriteRule ^ru/shablonlar/[a-z0-9-]+/$ ru/shablonlar/_/index.html [L]
RewriteRule ^ru/shablonlar/[a-z0-9-]+/index\.txt$ ru/shablonlar/_/index.txt [L]
RewriteRule ^ru/namuna/[a-z0-9-]+/$ ru/namuna/_/index.html [L]
RewriteRule ^ru/namuna/[a-z0-9-]+/index\.txt$ ru/namuna/_/index.txt [L]
# Inglizcha versiya (/en/...)
RewriteRule ^en/buyurtma/[^/]+/(.*)$ en/buyurtma/_/$1 [L]
RewriteRule ^en/kabinet/t/[^/]+/(.*)$ en/kabinet/t/_/$1 [L]
RewriteRule ^en/shablonlar/[a-z0-9-]+/$ en/shablonlar/_/index.html [L]
RewriteRule ^en/shablonlar/[a-z0-9-]+/index\.txt$ en/shablonlar/_/index.txt [L]
RewriteRule ^en/namuna/[a-z0-9-]+/$ en/namuna/_/index.html [L]
RewriteRule ^en/namuna/[a-z0-9-]+/index\.txt$ en/namuna/_/index.txt [L]


# Mehmon taklifnomasi: /jasur-madina/ → invite.php (OG meta bilan)
RewriteRule ^([a-z0-9][a-z0-9-]{1,79})/$ invite.php?slug=$1 [QSA,L]
