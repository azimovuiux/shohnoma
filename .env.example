# ── Majburiy ──
# Plesk → Databases → MySQL/MariaDB bazasi
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/shohnoma
SITE_URL=https://shohnoma.uz
# Uzun tasodifiy satr (masalan: openssl rand -hex 32)
SESSION_SECRET=
# Admin panelga kirish huquqi beriladigan telefonlar (vergul bilan)
ADMIN_PHONES=+998901234567
# Yuklangan fayllar (deploy papkasidan tashqarida bo‘lgani ma’qul)
UPLOAD_DIR=../shohnoma-storage/uploads

# ── SMS (Eskiz.uz) — kirish kodi ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=

# ── Payme (Merchant API) ──
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=0

# ── Click (SHOP API) ──
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# ── P2P (kartaga o‘tkazma) ──
P2P_CARD=8600 0000 0000 0000
P2P_HOLDER=SHOHNOMA SERVIS
P2P_BANK=UZCARD

# ── Boshqa ──
GOOGLE_PAY_ENABLED=0
# Haqiqiy provayderlarsiz to‘lovni sinash (productionda 0)
PAYMENTS_SANDBOX=0
# Kunlik eslatma: /api/cron/reminders?secret=...
CRON_SECRET=
